<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>秘密小岛</title>
<style>
:root{--bg:#d8cbbd;--card:#eee5d9;--text:#51483f;--wood:#d9c9b7;--wood2:#a99580;--accent:#a98b72;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--card:#2b2a33;--text:#f3ead6}}
:root[data-theme="dark"]{--card:#2b2a33;--text:#f3ead6}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:linear-gradient(145deg,#e0d4c6 0%,#d2c1ae 55%,#c4b09b 100%);font-family:"PingFang SC","Microsoft YaHei","Noto Sans SC",system-ui,sans-serif;color:#fff}
header{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 14px;background:rgba(119,103,86,.18);flex-wrap:wrap}
.names{font-size:14px;font-weight:600}
.days{font-size:22px;font-weight:800;color:#eee5d9;text-shadow:2px 2px 0 rgba(0,0,0,.3)}
.days small{font-size:12px;font-weight:500;display:block;text-align:center;color:#fff}
.btn{font:inherit;font-size:13px;background:var(--wood);color:#3b2a1a;border:1px solid var(--wood2);box-shadow:0 3px 0 rgba(81,72,63,.16);padding:5px 12px;cursor:pointer;border-radius:8px}
.btn:active{transform:translateY(2px);box-shadow:0 1px 0 var(--wood2)}
#stage{position:relative;max-width:1100px;margin:12px auto;width:calc(100% - 16px);aspect-ratio:40/26;overflow:hidden;border:2px solid rgba(81,72,63,.22);border-radius:12px}
canvas{display:block;width:100%;height:100%;image-rendering:pixelated}
.spot{position:absolute;transform:translate(-50%,-50%);font:inherit;font-size:clamp(8px,1.5vw,13px);background:var(--wood);color:#3b2a1a;border:1px solid var(--wood2);box-shadow:0 2px 0 rgba(81,72,63,.14);padding:2px 6px;cursor:pointer;white-space:nowrap;border-radius:7px;z-index:2}
.spot:hover{background:#eee5d9;transform:translate(-50%,-56%)}

.hint{text-align:center;font-size:12px;opacity:.8;padding-bottom:16px}
#intro{position:fixed;inset:0;z-index:20;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(81,72,63,.68);backdrop-filter:blur(3px);text-align:center;transition:opacity .6s;padding:20px}
#intro.hide{opacity:0;pointer-events:none}
#intro h1{font-size:clamp(28px,7vw,46px);line-height:1.4;margin:0 0 10px;color:#eee5d9;text-shadow:3px 3px 0 rgba(0,0,0,.35);letter-spacing:4px}
#intro p{font-size:12px;letter-spacing:2px;opacity:.8;margin:0 0 26px}
#intro .btn{font-size:16px;padding:10px 26px}
#modal{position:fixed;inset:0;z-index:30;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.5);padding:16px}
#modal.on{display:flex}
.card{background:var(--card);color:var(--text);width:min(440px,100%);max-height:88vh;overflow:auto;border:1px solid var(--wood2);box-shadow:0 10px 28px rgba(81,72,63,.16);padding:18px;border-radius:12px}
.card h2{margin:0 0 10px;font-size:20px}
.card img{max-width:100%;border:3px solid var(--wood2);margin-bottom:10px;display:block}
.card p{white-space:pre-wrap;line-height:1.8;margin:0 0 14px;font-size:15px}
.card textarea,.card input[type=text],.card input[type=date]{width:100%;font:inherit;padding:8px;margin-bottom:10px;border:2px solid var(--wood2);background:transparent;color:inherit;border-radius:8px}
.card textarea{min-height:120px}
.row{display:flex;gap:8px;flex-wrap:wrap}
#home{position:fixed;inset:0;z-index:25;background:linear-gradient(145deg,#e0d4c6,#cdbba7);display:none;flex-direction:column;align-items:center;gap:10px;padding:calc(env(safe-area-inset-top,0px) + 10px) 8px 20px;overflow:auto}
#home.on{display:flex}
.hbar{display:flex;gap:12px;align-items:center;font-size:16px}
#hstage{position:relative;width:min(900px,100%);aspect-ratio:320/200;border:2px solid rgba(81,72,63,.22);border-radius:12px;overflow:hidden}
#toast{position:absolute;left:50%;top:10%;transform:translateX(-50%);background:var(--card);color:var(--text);padding:6px 14px;border:2px solid var(--wood2);border-radius:8px;font-size:14px;opacity:0;transition:opacity .3s;pointer-events:none;z-index:5}
#toast.on{opacity:1}
</style>
</head>
<body>
<header>
  <div class="names" id="names"></div>
  <div class="days"><span id="days">0</span> 天<small>在一起</small></div>
  <button class="btn" id="setBtn">⚙ 设置</button>
</header>
<div id="stage"><canvas id="cv" width="640" height="416"></canvas></div>
<div class="hint">哼哼 只属于你的小岛哦 · 每个地方都可以上传照片和文字！</div>

<div id="intro">
  <h1>奇怪的秘密小岛</h1>
  <p>来探索嘛 嘻嘻</p>
  <button class="btn" id="go">▶</button>
</div>
<div id="home"><div class="hbar"><button class="btn" id="hback">← 回去</button><b>🏠 我们的小家</b></div><div id="hstage"><canvas id="hcv" width="320" height="200"></canvas><button class="spot" style="left:16%;top:19%" data-i="4">🖼 相框</button><button class="spot" style="left:77%;top:20%" data-i="shelf">🪵 架子</button><button class="spot" style="left:78%;top:57%" data-i="desk">💻 电脑桌</button><button class="spot" style="left:23%;top:78%" data-i="bed">🛏 大大的床</button><button class="spot" style="left:65%;top:83%" data-i="cat">🐈 咪咪</button><div id="toast"></div></div><div class="hint">哪里都可以点哦 笨笨~</div></div>
<div id="modal"><div class="card" id="card"></div></div>

<script>
const W=40,H=26,T=16,KEY='island-v1';
const DEF=()=>({a:'笨笨',b:'',date:'2026-03-28',spots:[
{x:10,y:10,i:'🏠',l:'我们的家',t:'这里是我们的小窝。写下你们想一起布置的样子吧。'},
{x:16,y:6,i:'👀',l:'初次相遇',t:'那天的天气、那句话、那个瞬间……'},
{x:25,y:7,i:'💌',l:'悄悄话',t:'哼哼 有什么悄悄话要偷偷跟我讲'},
{x:32,y:10,i:'🌊',l:'一起看海',t:'想和你去看一次海。'},
{x:13,y:16,l:'(´；ω；)`',t:'不开心的时候一定要跟我说 虽然我解决不了 可是我可以一个大抱抱'},
{x:20,y:12,i:'🎂',l:'纪念日',t:'跟你在一起的每一天都是纪念日哦'},
{x:29,y:15,i:'✨',l:'想要的东西',t:'1. 一起旅行\n2. 一起养只猫\n3. 一起看日出'},
{x:19,y:19,i:'🍜',l:'一起吃饭',t:'以后有钱钱了就去吃点好的好嘛 呜呜'},
{x:26,y:19,i:'🎁',l:'小惊喜',t:'最爱你哦 笨笨 超级爱你 最想念你了呜呜 要贴贴'},
{x:7,y:16,i:'🗺️',l:'想做的事情',t:'以后要一起做的事 一定一定要一起做哦 拉勾勾'}]});
let S=DEF();
try{const j=JSON.parse(localStorage.getItem(KEY)||'null');if(j&&j.spots&&j.spots.length)S=j}catch(e){}
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}};
const $=s=>document.querySelector(s);

// ---- map ----
let seed=20240520;const rnd=()=>{seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296};
const land=[...Array(H)].map(()=>Array(W).fill(0)),occ=[...Array(H)].map(()=>Array(W).fill(0)),path=[...Array(H)].map(()=>Array(W).fill(0));
for(let y=0;y<H;y++)for(let x=0;x<W;x++){const d=((x-20)/17.5)**2+((y-13)/10.5)**2;if(d+(rnd()-.5)*.28<1)land[y][x]=1}
const L=(x,y)=>land[y]&&land[y][x];
const HUB=[20,13];
S.spots.forEach(s=>{let x=HUB[0],y=HUB[1];while(x!==s.x||y!==s.y){if(x!==s.x)x+=Math.sign(s.x-x);else y+=Math.sign(s.y-y);path[y][x]=1}});
const mark=(x0,y0,x1,y1)=>{for(let y=y0;y<=y1;y++)for(let x=x0;x<=x1;x++)if(occ[y])occ[y][x]=1};
S.spots.forEach(s=>mark(s.x-2,s.y-1,s.x+2,s.y+1));
mark(9,7,11,9);mark(22,15,24,16);mark(14,11,16,12);

const off=document.createElement('canvas');off.width=W*T;off.height=H*T;
const o=off.getContext('2d');
const r=(c,x,y,w,h,f)=>{c.fillStyle=f;c.fillRect(x,y,w,h)};
// shadow
for(let y=0;y<H;y++)for(let x=0;x<W;x++)if(L(x,y))r(o,x*T,y*T+5,T,T,'rgba(160,80,50,.28)');
for(let y=0;y<H;y++)for(let x=0;x<W;x++){if(!L(x,y))continue;
 const edge=!L(x-1,y)||!L(x+1,y)||!L(x,y-1)||!L(x,y+1);
 const px=x*T,py=y*T;
 if(edge){r(o,px,py,T,T,'#d9c9b7');if(rnd()<.3)r(o,px+rnd()*12|0,py+rnd()*12|0,2,2,'#c4b09b')}
 else if(path[y][x]){r(o,px,py,T,T,'#e7dacb');if(rnd()<.3)r(o,px+rnd()*12|0,py+rnd()*12|0,2,2,'#d2c1ae')}
 else{r(o,px,py,T,T,(x+y)%2?'#a5a789':'#b1b394');if(rnd()<.35)r(o,px+rnd()*12|0,py+rnd()*12|0,2,3,'#929779')}}
// pond
for(let y=11;y<=12;y++)for(let x=14;x<=16;x++){r(o,x*T,y*T,T,T,'#a6bbb2');}
r(o,14*T+4,11*T+4,6,2,'#e4ece7');r(o,15*T+6,12*T+8,6,2,'#e4ece7');
// house
const hx=9*T,hy=7*T-8;
r(o,hx,hy+16,48,24,'#f4ede3');r(o,hx-4,hy+8,56,8,'#a98b72');r(o,hx+4,hy,40,8,'#a98b72');r(o,hx+8,hy+2,8,3,'#c9ad98');
r(o,hx+20,hy+24,8,16,'#8a5a2b');r(o,hx+5,hy+22,9,8,'#a6bbb2');r(o,hx+34,hy+22,9,8,'#a6bbb2');
// trees & flowers
const tree=(x,y,pink)=>{const px=x*T,py=y*T-6,a=pink?'#c7aa9a':'#7f866b',b=pink?'#dfc8bb':'#9da184';
 r(o,px+7,py+10,3,8,'#684027');r(o,px+3,py+3,11,8,a);r(o,px+5,py,7,3,a);r(o,px+1,py+5,15,4,a);r(o,px+5,py+3,4,3,b)};
for(let y=1;y<H-1;y++)for(let x=1;x<W-1;x++){
 if(!L(x,y)||!L(x-1,y)||!L(x+1,y)||!L(x,y+1)||!L(x,y-1)||occ[y][x]||path[y][x])continue;
 const q=rnd();if(q<.11){tree(x,y,rnd()<.25);occ[y][x]=1}
 else if(q<.2){const c=['#fff','#d7bd8d','#c7aa9a'][rnd()*3|0];r(o,x*T+5,y*T+7,2,2,c);r(o,x*T+4,y*T+8,4,1,c);r(o,x*T+5,y*T+9,2,2,'#4a8a3d')}}
// dock
r(o,20*T,23*T,T,3*T,'#a8763f');for(let i=0;i<3;i++)r(o,20*T,(23+i)*T+14,T,2,'#684027');

const cv=$('#cv'),c=cv.getContext('2d');
const waves=[...Array(80)].map(()=>({x:rnd()*W*T,y:rnd()*H*T|0,p:rnd()*6}));
function frame(t){
 r(c,0,0,W*T,H*T,'#d8cbbd');
 for(const w of waves){if(L(w.x/T|0,w.y/T|0))continue;r(c,w.x+Math.sin(t/900+w.p)*4,w.y,10,1,'rgba(255,255,255,.3)');r(c,w.x+3+Math.sin(t/900+w.p)*4,w.y+3,6,1,'rgba(255,255,255,.18)')}
 c.drawImage(off,0,0);requestAnimationFrame(frame)}
requestAnimationFrame(frame);

// ---- UI ----
const stage=$('#stage');
const pos=(el,x,y)=>{el.style.left=(x+.5)/W*100+'%';el.style.top=(y+.5)/H*100+'%'};
function buildSpots(){stage.querySelectorAll('.spot').forEach(e=>e.remove());
 S.spots.forEach((s,i)=>{const b=document.createElement('button');b.className='spot';b.textContent=s.i+' '+s.l;pos(b,s.x,s.y);
  b.onclick=()=>{if(i===0)$('#home').classList.add('on');else openSpot(i)};stage.appendChild(b)})}
function head(){$('#names').textContent=S.a+' ♥ '+S.b;
 const d=Math.floor((Date.now()-new Date(S.date+'T00:00:00'))/864e5)+1;$('#days').textContent=isNaN(d)?0:Math.max(d,0)}
const modal=$('#modal'),card=$('#card');
const close=()=>modal.classList.remove('on');
modal.onclick=e=>{if(e.target===modal)close()};
const el=(h)=>{const d=document.createElement('div');d.innerHTML=h;return d};
function openSpot(i,edit){const s=S.spots[i];card.innerHTML='';
 const h=document.createElement('h2');h.textContent=s.i+' '+s.l;card.appendChild(h);
 if(s.img){const im=document.createElement('img');im.src=s.img;card.appendChild(im)}
 if(!edit){const p=document.createElement('p');p.textContent=s.t;card.appendChild(p);
  const row=el('<div class="row"><button class="btn" id="ed">✏️ 编辑</button><button class="btn" id="cl">关闭</button></div>');card.appendChild(row);
  $('#ed').onclick=()=>openSpot(i,true);$('#cl').onclick=close}
 else{card.appendChild(el('<input type="text" id="tl" placeholder="标题"><textarea id="tx" placeholder="写点什么……"></textarea><input type="file" id="fl" accept="image/*"><div class="row" style="margin-top:10px"><button class="btn" id="sv">保存</button><button class="btn" id="cn">取消</button></div>'));
  $('#tl').value=s.l;$('#tx').value=s.t;let img=s.img;
  $('#fl').onchange=e=>{const f=e.target.files[0];if(!f)return;const rd=new FileReader();rd.onload=()=>{const im=new Image();im.onload=()=>{const k=Math.min(1,640/im.width),cc=document.createElement('canvas');cc.width=im.width*k;cc.height=im.height*k;cc.getContext('2d').drawImage(im,0,0,cc.width,cc.height);img=cc.toDataURL('image/jpeg',.7)};im.src=rd.result};rd.readAsDataURL(f)};
  $('#sv').onclick=()=>{s.l=$('#tl').value||s.l;s.t=$('#tx').value;s.img=img;save();buildSpots();openSpot(i)};
  $('#cn').onclick=()=>openSpot(i)}
 modal.classList.add('on')}
$('#setBtn').onclick=()=>{card.innerHTML='<h2>⚙ 小岛设置</h2>';
 card.appendChild(el('<input type="text" id="na" placeholder="你的名字"><input type="text" id="nb" placeholder="TA 的名字"><input type="date" id="dt"><div class="row"><button class="btn" id="ok">保存</button><button class="btn" id="rs">重置内容</button><button class="btn" id="cx">关闭</button></div>'));
 $('#na').value=S.a;$('#nb').value=S.b;$('#dt').value=S.date;
 $('#ok').onclick=()=>{S.a=$('#na').value||S.a;S.b=$('#nb').value||S.b;S.date=$('#dt').value||S.date;save();head();close()};
 $('#rs').onclick=()=>{if(confirm('确定恢复默认内容吗？')){S=DEF();save();buildSpots();head();close()}};
 $('#cx').onclick=close;modal.classList.add('on')};
$('#go').onclick=()=>$('#intro').classList.add('hide');
const hc=$('#hcv').getContext('2d'),hr=(x,y,w,h,f)=>{hc.fillStyle=f;hc.fillRect(x,y,w,h)};
(()=>{
  // Soft beige wall and warm oak floor
  hr(0,0,320,200,'#e0d4c6');
  hr(0,0,320,116,'#e0d4c6');
  hr(0,116,320,84,'#b49d86');
  for(let y=120;y<200;y+=12)hr(0,y,320,1,'#a38d78');
  for(let x=0;x<320;x+=54)hr(x,116,1,84,'#a38d78');
  hr(0,110,320,5,'#c3b19e');

  // Simple framed art on the wall
  hr(24,18,48,40,'#9c8875');hr(28,22,40,32,'#eee5d9');
  hr(32,42,32,8,'#a5a789');hr(42,28,12,12,'#b99579');
  hr(37,34,4,4,'#eee5d9');

  // Double bed placed against the left wall; no extra blanket or plant
  hr(8,116,128,70,'#866f5c');hr(12,120,120,60,'#d6c5b2');
  hr(16,124,112,17,'#eee5d9');hr(18,126,44,13,'#d2c1ae');
  hr(68,126,56,13,'#d2c1ae');
  hr(14,145,116,31,'#b69b83');hr(14,145,116,5,'#c2aa94');

  // Desk with computer on the right
  hr(190,83,112,9,'#806a57');hr(196,92,8,42,'#806a57');hr(288,92,8,42,'#806a57');
  hr(218,48,58,35,'#70685f');hr(222,52,50,27,'#c4d0c9');
  hr(226,56,42,19,'#a6bbb2');hr(243,83,8,5,'#70685f');
  hr(234,88,28,3,'#665b52');hr(236,96,24,3,'#665b52');
  // Desk lamp
  hr(282,63,4,20,'#88725f');hr(274,59,18,5,'#b99579');hr(277,56,12,4,'#c4b09b');

  // Floating wall shelf with books and small keepsakes
  hr(204,18,92,7,'#88725f');hr(210,25,4,17,'#a98b72');
  hr(220,25,4,17,'#a98b72');hr(232,25,7,17,'#a98b72');
  hr(243,25,5,17,'#b99579');hr(257,27,12,13,'#a5a789');
  hr(260,30,6,7,'#e0d4c6');hr(278,27,10,13,'#c4b09b');

  // Large charcoal-grey Maine Coon cat, with a fluffy ruff and bushy tail
  const fur='#55575b',fur2='#707277',fur3='#3e4146',light='#b9b7b0';
  hr(178,143,55,31,fur3);hr(183,137,48,35,fur);hr(190,132,36,39,fur2);
  hr(184,145,10,18,fur2);hr(220,145,12,18,fur3);
  hr(194,119,30,28,fur);hr(190,112,10,13,fur3);hr(215,110,11,15,fur3);
  hr(193,111,5,8,fur2);hr(218,109,5,9,fur2);
  hr(198,124,5,4,'#d9c9b6');hr(213,124,5,4,'#d9c9b6');
  hr(201,129,4,3,'#b98783');hr(207,132,3,2,'#e0d4c6');
  hr(197,135,4,2,light);hr(211,135,4,2,light);
  hr(185,127,8,13,fur2);hr(221,126,8,14,fur2);
  hr(190,165,13,8,fur2);hr(211,165,14,8,fur2);
  hr(228,149,10,8,fur3);hr(235,142,8,10,fur);hr(239,135,7,10,fur2);
  hr(243,131,5,8,fur3);
})();
let tt,catTap=0;$('#hback').onclick=()=>$('#home').classList.remove('on');
document.querySelectorAll('#hstage .spot').forEach(b=>b.onclick=()=>{
  const i=b.dataset.i;
  if(i==='cat'){
    const lines=[
      '大大的黑灰色缅因猫慢慢走过来，用毛茸茸的脑袋轻轻蹭你。',
      '它舒服地呼噜起来，蓬松的大尾巴轻轻晃动。',
      '它伸了个懒腰，抬起爪子，安静地陪在你身边。',
      '它在你旁边坐下，眯着眼睛，像是在等你再摸摸它。'
    ];
    const t=$('#toast');t.textContent=lines[catTap%lines.length];catTap++;
    t.classList.add('on');clearTimeout(tt);tt=setTimeout(()=>t.classList.remove('on'),3800);
  }else if(i==='shelf'){
    const t=$('#toast');t.textContent='置物架上放着书本、相片和日常小收藏。点击它，看看这些小物件。';
    t.classList.add('on');clearTimeout(tt);tt=setTimeout(()=>t.classList.remove('on'),3200);
  }else if(i==='desk'){
    const t=$('#toast');t.textContent='电脑桌：可以一起整理照片、写下计划，也可以在这里工作和学习。';
    t.classList.add('on');clearTimeout(tt);tt=setTimeout(()=>t.classList.remove('on'),3200);
  }else if(i==='bed'){
    const t=$('#toast');t.textContent='双人床靠墙摆放，房间中间留出舒适的活动空间。';
    t.classList.add('on');clearTimeout(tt);tt=setTimeout(()=>t.classList.remove('on'),3200);
  }else openSpot(+i);
});
buildSpots();head();
</script>
</body>
</html>
